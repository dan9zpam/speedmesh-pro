{
  "manifest_version": 3,
  "name": "speedmesh",
  "version": "3.2",
  "description": "Многофункциональный помощник для учителей в МЭШ: ускорение работы, калькулятор оценок, умный прицел журнала, таймер и генератор КТП.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "alarms"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://school.mos.ru/*",
        "*://*.school.mos.ru/*",
        "*://dnevnik.mos.ru/*",
        "*://*.dnevnik.mos.ru/*"
      ],
      "js": [
        "date_spoof.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://school.mos.ru/*",
        "*://*.school.mos.ru/*",
        "*://dnevnik.mos.ru/*",
        "*://*.dnevnik.mos.ru/*"
      ],
      "js": [
        "speedup.js",
        "ghost_injector.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://school.mos.ru/*",
        "*://*.school.mos.ru/*",
        "*://dnevnik.mos.ru/*",
        "*://*.dnevnik.mos.ru/*"
      ],
      "js": [
        "window_manager.js",
        "content.js",
        "architect.js",
        "crosshair.js",
        "spy_content.js",
        "achievements.js",
        "randomizer.js",
        "visits.js",
        "absences.js",
        "homework.js",
        "ktp.js",
        "ktp_injector.js",
        "timer.js",
        "calculator.js",
        "sticky_avg.js",
        "feature_scanner.js",
        "jszip.min.js",
        "mentor_journals.js",
        "themes.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js",
        "ktp_interceptor.js",
        "api_spy.js",
        "guide.html",
        "gallery.html",
        "auto_ktp.js",
        "ghost_mode.js"
      ],
      "matches": [
        "*://school.mos.ru/*",
        "*://*.school.mos.ru/*",
        "*://dnevnik.mos.ru/*",
        "*://*.dnevnik.mos.ru/*"
      ]
    }
  ],
  "host_permissions": [
    "*://*.school.mos.ru/*",
    "*://*.dnevnik.mos.ru/*"
  ],
  "background": {
    "service_worker": "cookie_cleaner.js"
  }
}
